---
interface ShareTarget {
  href: string;
  label: string;
  mark: string;
}

interface Props {
  description?: string;
  title: string;
  url: string;
}

const { description = '', title, url } = Astro.props;
const encodedUrl = encodeURIComponent(url);
const encodedTitle = encodeURIComponent(title);
const encodedText = encodeURIComponent(`${title} ${url}`);
const encodedDescription = encodeURIComponent(description);
const shareTargets: ShareTarget[] = [
  {
    href: `https://wa.me/?text=${encodedText}`,
    label: 'WhatsApp',
    mark: 'WA',
  },
  {
    href: `https://twitter.com/intent/tweet?text=${encodedTitle}&url=${encodedUrl}`,
    label: 'X',
    mark: 'X',
  },
  {
    href: `sms:?&body=${encodedText}`,
    label: 'Messages',
    mark: 'SMS',
  },
  {
    href: `https://www.facebook.com/sharer/sharer.php?u=${encodedUrl}`,
    label: 'Facebook',
    mark: 'f',
  },
  {
    href: `mailto:?subject=${encodedTitle}&body=${encodedDescription}%0A%0A${encodedUrl}`,
    label: 'Email',
    mark: '@',
  },
];
---

<div class="share-sheet" data-share-widget data-share-url={url}>
  <button class="share-sheet__trigger" type="button" data-share-open>
    <svg aria-hidden="true" viewBox="0 0 24 24" focusable="false">
      <path
        d="M18 16.2c-1.1 0-2 .5-2.6 1.3L8.9 13.7a3.2 3.2 0 0 0 0-3.4l6.4-3.7A3.3 3.3 0 1 0 14.2 4c0 .2 0 .4.1.6L7.8 8.4a3.3 3.3 0 1 0 0 7.2l6.5 3.8-.1.6A3.3 3.3 0 1 0 18 16.2Z"
      ></path>
    </svg>
    <span>Share</span>
  </button>

  <dialog class="share-sheet__dialog" data-share-dialog aria-labelledby="share-title">
    <div class="share-sheet__panel">
      <header class="share-sheet__header">
        <h2 id="share-title">Share recipe</h2>
        <button class="share-sheet__close" type="button" data-share-close aria-label="Close share dialog">
          <span aria-hidden="true"></span>
        </button>
      </header>

      <div class="share-sheet__targets" aria-label="Share destinations">
        <button class="share-sheet__target" type="button" data-share-copy>
          <span class="share-sheet__mark share-sheet__mark--copy" aria-hidden="true">
            <svg viewBox="0 0 24 24" focusable="false">
              <path d="M8 7h9a3 3 0 0 1 3 3v7a3 3 0 0 1-3 3H8a3 3 0 0 1-3-3v-7a3 3 0 0 1 3-3Zm0 2a1 1 0 0 0-1 1v7a1 1 0 0 0 1 1h9a1 1 0 0 0 1-1v-7a1 1 0 0 0-1-1H8Zm1-5h8v2H9a3 3 0 0 0-3 3v7H4V9a5 5 0 0 1 5-5Z"></path>
            </svg>
          </span>
          <span>Copy link</span>
        </button>
        {
          shareTargets.map((target) => (
            <a
              class="share-sheet__target"
              href={target.href}
              target="_blank"
              rel="noreferrer"
            >
              <span class={`share-sheet__mark share-sheet__mark--${target.label.toLowerCase()}`} aria-hidden="true">
                {target.mark}
              </span>
              <span>{target.label}</span>
            </a>
          ))
        }
      </div>

      <div class="share-sheet__copy-row">
        <input type="text" value={url} readonly data-share-input aria-label="Recipe URL" />
        <button type="button" data-share-copy>Copy</button>
      </div>
      <p class="share-sheet__status" data-share-status aria-live="polite"></p>
    </div>
  </dialog>
</div>

<script>
  for (const widget of document.querySelectorAll('[data-share-widget]')) {
    const openButton = widget.querySelector<HTMLButtonElement>('[data-share-open]');
    const dialog = widget.querySelector<HTMLDialogElement>('[data-share-dialog]');
    const input = widget.querySelector<HTMLInputElement>('[data-share-input]');
    const status = widget.querySelector<HTMLElement>('[data-share-status]');
    const shareUrl = widget.getAttribute('data-share-url') ?? input?.value ?? window.location.href;

    if (!openButton || !dialog || !input) {
      continue;
    }

    const setStatus = (message: string) => {
      if (status) {
        status.textContent = message;
      }
    };

    const copyUrl = async () => {
      input.value = shareUrl;

      try {
        await navigator.clipboard.writeText(shareUrl);
      } catch {
        input.focus();
        input.select();
        document.execCommand('copy');
      }

      setStatus('Link copied');
    };

    openButton.addEventListener('click', () => {
      input.value = shareUrl;
      setStatus('');
      dialog.showModal();
    });

    for (const closeButton of widget.querySelectorAll('[data-share-close]')) {
      closeButton.addEventListener('click', () => dialog.close());
    }

    for (const copyButton of widget.querySelectorAll('[data-share-copy]')) {
      copyButton.addEventListener('click', copyUrl);
    }

    dialog.addEventListener('click', (event) => {
      if (event.target === dialog) {
        dialog.close();
      }
    });
  }
</script>
