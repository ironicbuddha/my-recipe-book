---
import type { PreparationPhase } from '../lib/recipe-presentation';
interface Props { phase: PreparationPhase }
const { phase } = Astro.props;
---
<section class="preparation-group" aria-labelledby={phase.id}>
  <h2 id={phase.id} tabindex="-1">{phase.title}</h2>
  <div class="phase-prelude culinary-prose" set:html={phase.preludeHtml} />
  <div class="preparation-matrix">
    <div class="group-ingredients">
      {phase.ingredients.length > 0 && <h3 class="ingredient-heading">Ingredient Uses</h3>}
      <ul class="ingredient-list">
        {phase.ingredients.map((use) => (
          <li class="ingredient-entry" data-use-key={use.key}>
            <div class="ingredient-name">
              <span set:html={use.labelHtml} />
              {use.noteHtml && <p class="ingredient-note" set:html={use.noteHtml} />}
            </div>
            <dl class="ingredient-measures">
              <div><dt>Quantity</dt><dd>{use.quantity}</dd></div>
              <div><dt>Scaling</dt><dd>{use.scaling}</dd></div>
            </dl>
          </li>
        ))}
      </ul>
    </div>
    <div class="group-procedure">
      <h3 class="procedure-heading">Method</h3>
      <div class="method-content culinary-prose" set:html={phase.methodHtml} />
    </div>
  </div>
  <div class="ingredient-context culinary-prose" set:html={phase.ingredientNotesHtml} />
  <div class="phase-knowledge culinary-prose" set:html={phase.supportingHtml} />
</section>
