---
import SiteLayout from '../layouts/SiteLayout.astro';
---

<SiteLayout
  title="Recipe withdrawn | Modernist Recipe Book"
  description="This recipe is no longer available."
>
  <section class="page-header page-header--tight">
    <p class="eyebrow">Recipe unavailable</p>
    <h1>Recipe withdrawn</h1>
  </section>
  <article class="recipe-sheet">
    <p>This recipe has been withdrawn. It has no canonical replacement.</p>
    <p><a href="/recipes/">Browse all recipes</a></p>
  </article>
</SiteLayout>
