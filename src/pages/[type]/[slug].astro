---
import SiteLayout from '../../layouts/SiteLayout.astro';
import { loadLibrary, renderContent, routeFor } from '../../lib/library';

export function getStaticPaths() {
  const library = loadLibrary();
  return [...library.knowledge, ...library.entries.filter((entry) => entry.type === 'experiment')].map((entry) => ({
    params: { slug: entry.identity.split('/')[1], type: `${entry.type}s` },
    props: {
      entry,
      html: renderContent(entry.body, library),
      backlinkEntries: entry.backlinks
        .map((identity) => library.entries.find((candidate) => candidate.identity === identity))
        .filter((candidate) => candidate !== undefined),
    },
  }));
}

const { entry, html, backlinkEntries } = Astro.props;
---

<SiteLayout
  title={`${entry.title} | Modernist Recipe Book`}
  description={entry.type === 'experiment' ? 'Completed culinary evidence.' : `Curated ${entry.type} Knowledge Note.`}
>
  <section class="page-header page-header--tight">
    <p class="eyebrow">{entry.type}</p>
    <h1>{entry.title}</h1>
  </section>
  <article class="recipe-sheet">
    {
      entry.type === 'experiment' && entry.subjectLabel && (
        <p><strong>Primary subject:</strong> {entry.subjectLabel}</p>
      )
    }
    <div class="recipe-body" set:html={html} />
    {
      entry.corrections.length > 0 && (
        <section aria-label="Published corrections">
          <h2>Published corrections</h2>
          <ul>
            {entry.corrections.map((identity) => <li><a href={routeFor(identity)}>{identity}</a></li>)}
          </ul>
        </section>
      )
    }
    {entry.backlinks.length > 0 && (
      <section aria-label="Referenced by">
        <h2>Referenced by</h2>
        <ul>
          {backlinkEntries.map((backlink) => (
            <li><a href={backlink.href}>{backlink.title}</a></li>
          ))}
        </ul>
      </section>
    )}
  </article>
</SiteLayout>
