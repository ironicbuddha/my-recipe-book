---
import SiteLayout from '../../layouts/SiteLayout.astro';
import { loadLibrary } from '../../lib/library';

export function getStaticPaths() {
  const library = loadLibrary();
  const types = ['experiments', 'ingredients', 'principles', 'techniques'];
  return types.map((type) => ({
    params: { type },
    props: {
      entries: library.entries.filter((entry) => `${entry.type}s` === type),
      label: type.charAt(0).toUpperCase() + type.slice(1),
    },
  }));
}

const { entries, label } = Astro.props;
---

<SiteLayout title={`${label} | Modernist Recipe Book`} description={`Curated ${label.toLowerCase()} in the culinary library.`}>
  <section class="page-header">
    <p class="eyebrow">{label === 'Experiments' ? 'Completed evidence' : 'Curated knowledge'}</p>
    <h1>{label}</h1>
    <p class="lead">{entries.length} {label === 'Experiments' ? 'Completed Experiments.' : 'human-curated Knowledge Notes.'}</p>
  </section>
  <section class="section-shell">
    <ul class="knowledge-list">
      {entries.map((entry) => (
        <li>
          <a href={entry.href}>{entry.title}</a>
          <p>{entry.type === 'experiment' ? entry.subjectLabel : `${entry.backlinks.length} recipe backlink${entry.backlinks.length === 1 ? '' : 's'}`}</p>
        </li>
      ))}
    </ul>
  </section>
</SiteLayout>
